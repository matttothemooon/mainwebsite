# Template — safe to commit, contains no real values.
#
# PRODUCTION: do not use this file. Set these in the Vercel dashboard under
#   Settings -> Environment Variables, then redeploy.
# LOCAL: copy to .env.local and fill in. .env.local is gitignored.
#
# `npm run dev` bypasses auth entirely on localhost, so none of these are
# needed just to edit the site locally. They only matter for `npm run dev:auth`,
# which exercises the real Discord login.

# ---- required in production ----

# discord.com/developers/applications -> your app -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Comma-separated Discord user IDs allowed into /admin.
# Discord -> Settings -> Advanced -> Developer Mode, then right-click your
# name -> Copy User ID.
# Leaving this blank falls back to the owner ID hardcoded in lib/auth.js, so a
# fresh deploy is never locked out. Setting it here overrides that completely.
DISCORD_ALLOWED_IDS=436300903927119873

# Any long random string. Signs the session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ---- profile storage ----
# Create these in Supabase. Keep the service role key server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# VERCEL                  always "1" on Vercel; the dev auth bypass checks it

# ---- optional: Twitch avatar/display-name autofill ----
# dev.twitch.tv/console/apps -> Register Your Application
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---- optional: Decap CMS at /cms (GitHub OAuth, unrelated to /admin) ----
# github.com/settings/developers -> OAuth Apps -> New
# Callback URL: https://<your-domain>/api/cms-callback
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
